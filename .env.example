# The shop's own API. Wikinggruppen hands out the user name and password per shop.
WGR_API_URL=https://your-shop.example/api/v1/
WGR_API_USER=
WGR_API_PASSWORD=
# Optional: Wikinggruppen's forwarding service (sends WGR_API_URL in the Api-Url header)
# WGR_FORWARD_URL=https://api.wikinggruppen.se/forward/
# Writes (Article.set, Category.set, ...) are off unless this is 1
# WGR_ALLOW_WRITE=1
